<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_dns_tile" android:roundIcon="@drawable/ic_dns_tile" android:label="DNS Switcher"
        android:theme="@style/Theme.DNSSwitcher">

        <activity
            android:name=".DnsSelectorActivity"
            android:theme="@style/Theme.DNSSwitcher"
            android:exported="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".DnsTileService"
            android:exported="true"
            android:label="Private DNS"
            android:icon="@drawable/ic_dns_tile" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>